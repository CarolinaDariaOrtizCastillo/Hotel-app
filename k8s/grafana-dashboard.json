{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Estado de los Microservicios (UP/DOWN)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=~\"hotel-.*\"}",
          "legendFormat": "{{ job }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Tasa de Peticiones por Minuto (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count[1m]) * 60)",
          "legendFormat": "{{ service }} req/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latencia p95 de Endpoints (Segundos)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Delay Artificial Configurado en Catálogo (ms) - Casuística 2",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "hotel_catalog_artificial_delay_ms",
          "legendFormat": "Delay (ms)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 5000,
          "min": 0,
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 2000 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Métrica de Negocio: Reservas Exitosas vs Fallidas",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "expr": "increase(hotel_booking_created_total[1m])",
          "legendFormat": "Exitosas (+)",
          "refId": "A"
        },
        {
          "expr": "increase(hotel_booking_failures_total[1m])",
          "legendFormat": "Fallidas (-)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Métrica de Negocio: Reservas Activas en Memoria",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "expr": "hotel_booking_active_total",
          "legendFormat": "Reservas Activas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["hotel", "valle-grande", "kubernetes", "microservices"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Hotel Microservices - Observabilidad y Negocio",
  "uid": "hotel-obs-01",
  "version": 1
}
